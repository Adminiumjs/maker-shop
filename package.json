{
  "name": "maker-shop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Maker Shop \u2014 an open-source made-to-order shop and workshop example app for Adminium.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --base=/demo/maker-shop/",
    "build:surface:staff": "VITE_ADMINIUM_SURFACE_SIDE=staff tsc -b && VITE_ADMINIUM_SURFACE_SIDE=staff vite build --base=/apps/maker/staff/ --outDir dist-surface/maker/staff",
    "preview": "vite preview",
    "dev:staff": "VITE_ADMINIUM_SURFACE_SIDE=staff vite",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "manifest": "vite-node scripts/write-manifest.ts",
    "manifest:check": "vite-node scripts/check-manifest.ts",
    "sample": "vite-node scripts/write-sample.ts",
    "contract": "CONTRACT=1 vitest run src/contract/"
  },
  "dependencies": {
    "@adminiumjs/public-client": "^0.2.2",
    "lucide-react": "^0.462.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^2.1.9",
    "zod": "^4.4.3"
  }
}
