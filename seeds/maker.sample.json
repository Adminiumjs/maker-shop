        {
          "@label": "settings",
          "studio_name": "Birch Row",
          "address": "Unit 4, Station Yard, Settle BD24 9AA",
          "email": "studio@birchrow.example",
          "about": "Two of us, a laser, two printers and a kiln, in a unit by the station in Settle. Everything is made to order.",
          "about_page": "Birch Row is Ada and Nell. Ada came from a joinery shop and does the cutting and the wood; Nell throws the mugs and runs the kiln. We work from a unit behind the station, Tuesday to Saturday, and between us we make everything ourselves.\n\nWe don't hold finished pieces. When an order comes in we cut it, print it or throw it that week, then send you a picture before anything is engraved. That is why a coaster takes three days and a mug takes ten — the mug is fired twice.",
          "materials_note": "Walnut, ply and slate are all real, so the grain and the mottling change from piece to piece. Two coasters cut from the same board will not match exactly, and a slate sign has whatever the quarry gave it. We pick the nicest face for the lettering and let the rest be what it is.",
          "ref_prefix": "BR-",
          "first_order_number": 2291,
          "proof_reminder_days": 3,
          "packaging_grams": 120,
          "taking_orders": true
        }
      ]
    },
